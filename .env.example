# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reel_downloader?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=30
DOWNLOAD_RATE_LIMIT_WINDOW=3600
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=10

# Limits
MAX_DOWNLOAD_SIZE=104857600
REQUEST_TIMEOUT=30000
MAX_URL_LENGTH=2048

# Media Processing
MEDIA_CACHE_TTL=3600
RESOLUTION_CACHE_TTL=1800

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Optional: External Services
# SENTRY_DSN=
# ANALYTICS_ID=