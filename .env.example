# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reel_downloader?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=30
DOWNLOAD_RATE_LIMIT_WINDOW=3600
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=10

# Limits
MAX_DOWNLOAD_SIZE=104857600
REQUEST_TIMEOUT=30000
MAX_URL_LENGTH=2048

# Media Processing
MEDIA_CACHE_TTL=3600
RESOLUTION_CACHE_TTL=1800

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Optional: External Services
# SENTRY_DSN=
# ANALYTICS_ID=

# ---------------------------------------------------------------------------
# Instagram signed-in session (OPTIONAL)
# ---------------------------------------------------------------------------
# Instagram only serves some reels to a signed-in session. Configuring these
# lets the resolver fall back to an authenticated read for exactly those reels;
# everything else keeps working anonymously with no session at all.
#
# Automating an Instagram login violates Instagram's Terms of Use and is the
# most likely reason the account below gets banned. Use a throwaway account.
#
#   INSTAGRAM_USERNAME / INSTAGRAM_PASSWORD  the account to sign in with
#   INSTAGRAM_2FA_SECRET                    base32 TOTP secret, only if the
#                                           account has authenticator 2FA
#
# ADMIN_API_KEY guards POST/GET/DELETE /api/auth/instagram/session, which
# accepts a plaintext password. It is REQUIRED for that route to work at all;
# without it the route returns 503 rather than running unauthenticated.
# Generate with: openssl rand -base64 32
#
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
# INSTAGRAM_2FA_SECRET=
# ADMIN_API_KEY=
#
# Optional: force a specific browser binary. By default the app auto-detects a
# locally installed Chrome or Edge, which avoids the `npx playwright install
# chromium` download (that CDN is unreachable on some networks).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=