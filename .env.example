# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reel_downloader?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Security
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=30
DOWNLOAD_RATE_LIMIT_WINDOW=3600
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=10

# Limits
MAX_DOWNLOAD_SIZE=104857600
REQUEST_TIMEOUT=30000
MAX_URL_LENGTH=2048

# Media Processing
MEDIA_CACHE_TTL=3600
RESOLUTION_CACHE_TTL=1800

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Optional: External Services
# SENTRY_DSN=
# ANALYTICS_ID=

# YouTube extraction service (ytdlp-service/)
# Vercel cannot spawn the yt-dlp binary, so the app calls a small hosted
# wrapper instead. Leave both unset to fall back to a local yt-dlp binary
# (development only) and then to oEmbed metadata-only resolution.
# YTDLP_SERVICE_URL=https://your-service-xxxxx.koyeb.app
# Must match YTDLP_SERVICE_TOKEN on the service; the service rejects every
# request when it is unset.
# YTDLP_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Instagram signed-in session (OPTIONAL)
# ---------------------------------------------------------------------------
# Instagram only serves some reels to a signed-in session. Configuring one of
# the two options below lets the resolver fall back to an authenticated read
# for exactly those reels; everything else keeps working anonymously with no
# session at all. Neither option is a hard dependency of resolution.
#
# RECOMMENDED - supplied cookies. Sign in to instagram.com in a normal
# browser, export the cookies for the instagram.com domain, and paste them
# here. Accepts either shape, since both are what people actually have:
#
#   INSTAGRAM_SESSION_COOKIES  a cookie header string, built by joining the
#                               exported name/value pairs as
#                               "name=value; name=value" - or the raw JSON
#                               array/object that a cookies-export extension
#                               produces
#
# A "sessionid" cookie must be present or the session is rejected; re-export
# the cookies while signed in. Cookies win over automated login whenever both
# are configured.
#
# Why this is the recommended option: it needs no browser at all, so it is the
# only mode that works on a serverless host where the filesystem is ephemeral
# and no Chromium can be installed. It also avoids automated login, which is
# the behavior Instagram is most likely to challenge.
#
# ALTERNATIVE - automated login. Instagram's Terms of Use forbid automating a
# login, and this is the single most likely reason the account gets banned. Use
# a throwaway account, never a personal one. It needs a Chromium: a locally
# installed Chrome or Edge, or Playwright's bundled build via
# `npx playwright install chromium`.
#
#   INSTAGRAM_USERNAME / INSTAGRAM_PASSWORD  the account to sign in with
#   INSTAGRAM_2FA_SECRET                    base32 TOTP secret, only if the
#                                           account has authenticator 2FA
#
# ADMIN_API_KEY guards POST/GET/DELETE /api/auth/instagram/session, which
# accepts a plaintext password. It is REQUIRED for that route to work at all;
# without it the route returns 503 rather than running unauthenticated.
# Generate with: openssl rand -base64 32
#
# INSTAGRAM_SESSION_COOKIES=
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
# INSTAGRAM_2FA_SECRET=
# ADMIN_API_KEY=
#
# Optional: override the User-Agent sent with a supplied-cookie session. Only
# set this to the exact User-Agent of the browser the cookies came from;
# a mismatch is a signal Instagram can act on. Defaults to a fixed desktop
# Chrome string when unset.
# INSTAGRAM_USER_AGENT=
#
# Optional: force a specific browser binary for the automated-login path. By
# default the app auto-detects a locally installed Chrome or Edge, which avoids
# the `npx playwright install chromium` download (that CDN is unreachable on
# some networks).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=